# Common Ignore
.idea/
.DS_Store
/node_modules
/.cache/
/.worktrees/

# AI
.codex/
.claude/
.qwen/
**/CLAUDE.md
**/AGENTS.md
.codegraph/

# Nix store paths
/store/

# nix secrets
*.age.key

# Dev
.direnv/

# Environment files
**/.env

# Build artifacts
result
result-*

# Generated topology diagram (published via jsDelivr from the topology branch)
/topology.svg

# For Taskfile checksum etc...
# 使用 **/ 而非 / 前缀，因为 Taskfile 会在任意子目录（如 .taskfile/nix/、infra/ 等）
# 运行时生成 .task/ 目录（存放 checksum、任务缓存等运行时产物），
# 这些不应进入版本控制
**/.task/

# 所有 logs/ 目录，递归匹配
#（容器日志如 .cntr/axonhub/logs/、.cntr/new-api/logs/ 等）
**/logs/
**/data/

# caddy 运行时配置（证书 data/ 已由 **/data/ 覆盖；config/ 为运行时 caddy 配置）
.cntr/caddy/config/

# ignore 本项目里所有 checksum folder
# 主要针对 taskfile checksum
checksum/

# Python cache
__pycache__/
*.pyc

# Ruff cache
.ruff_cache/


# local notes — not part of flake tree commits（仅根目录 docs/，锚定防误伤嵌套 docs）
/docs/

# zzz skill — references/**/*.md 是 prompt 源（YAML→md 迁移中，见 LUC-377）


# APM dependencies
apm_modules/
apm.lock.yaml

# 无人值守部署产物（CI/local）
/deploy-logs/
/deploy-summary.json
/deploy-summary.md
