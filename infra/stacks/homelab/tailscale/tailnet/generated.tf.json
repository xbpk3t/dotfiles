{
  "data": {
    "tailscale_device": {
      "servers": {
        "for_each": {
          "hermes-wb": true,
          "macos-ws": true,
          "nixos-vps-agt": true,
          "nixos-vps-dev": true,
          "nixos-wsl": true
        },
        "hostname": "${each.key}"
      }
    }
  },
  "moved": [
    {
      "from": "tailscale_device_key.devices[\"hermes-wb\"]",
      "to": "tailscale_device_key.servers[\"hermes-wb\"]"
    },
    {
      "from": "tailscale_device_tags.devices[\"hermes-wb\"]",
      "to": "tailscale_device_tags.hermes_wb"
    },
    {
      "from": "tailscale_device_key.devices[\"macos-ws\"]",
      "to": "tailscale_device_key.servers[\"macos-ws\"]"
    },
    {
      "from": "tailscale_device_tags.devices[\"macos-ws\"]",
      "to": "tailscale_device_tags.macos_ws"
    },
    {
      "from": "tailscale_device_key.devices[\"nixos-vps-agt\"]",
      "to": "tailscale_device_key.servers[\"nixos-vps-agt\"]"
    },
    {
      "from": "tailscale_device_tags.devices[\"nixos-vps-agt\"]",
      "to": "tailscale_device_tags.nixos_vps_agt"
    },
    {
      "from": "tailscale_device_key.devices[\"nixos-vps-dev\"]",
      "to": "tailscale_device_key.servers[\"nixos-vps-dev\"]"
    },
    {
      "from": "tailscale_device_tags.devices[\"nixos-vps-dev\"]",
      "to": "tailscale_device_tags.nixos_vps_dev"
    },
    {
      "from": "tailscale_device_key.devices[\"nixos-wsl\"]",
      "to": "tailscale_device_key.servers[\"nixos-wsl\"]"
    },
    {
      "from": "tailscale_device_tags.devices[\"nixos-wsl\"]",
      "to": "tailscale_device_tags.nixos_wsl"
    }
  ],
  "output": {
    "vps_join_key": {
      "sensitive": true,
      "value": "${tailscale_tailnet_key.vps_join.key}"
    },
    "ws_join_key": {
      "sensitive": true,
      "value": "${tailscale_tailnet_key.ws_join.key}"
    }
  },
  "provider": {
    "tailscale": {
      "tailnet": "xbpk3t.github"
    }
  },
  "resource": {
    "tailscale_acl": {
      "main": {
        "acl": "${var.tailscale_acl_allow_all ? \"{\\\"autoApprovers\\\":{\\\"exitNode\\\":[\\\"tag:exit\\\"],\\\"services\\\":{\\\"svc:9router\\\":[\\\"tag:svc\\\"],\\\"svc:nezha\\\":[\\\"tag:svc\\\"]}},\\\"derpMap\\\":{\\\"OmitDefaultRegions\\\":false,\\\"Regions\\\":{\\\"900\\\":{\\\"Nodes\\\":[{\\\"DERPPort\\\":10043,\\\"HostName\\\":\\\"nva.lucc.dev\\\",\\\"IPv4\\\":\\\"1.15.64.188\\\",\\\"Name\\\":\\\"900a\\\",\\\"RegionID\\\":900,\\\"STUNPort\\\":10078}],\\\"RegionCode\\\":\\\"agt\\\",\\\"RegionID\\\":900,\\\"RegionName\\\":\\\"agt-sh\\\"}}},\\\"grants\\\":[{\\\"dst\\\":[\\\"*\\\"],\\\"ip\\\":[\\\"*\\\"],\\\"src\\\":[\\\"*\\\"]},{\\\"dst\\\":[\\\"tag:vps\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"dev\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"agt\\\"]},{\\\"dst\\\":[\\\"tag:ws\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"tag:vps\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"tag:svc\\\"],\\\"ip\\\":[\\\"8008\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"tag:svc\\\"],\\\"ip\\\":[\\\"8008\\\"],\\\"src\\\":[\\\"macos-ws\\\"]},{\\\"dst\\\":[\\\"svc:9router\\\",\\\"svc:nezha\\\"],\\\"ip\\\":[\\\"80\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"autogroup:internet\\\"],\\\"ip\\\":[\\\"*\\\"],\\\"src\\\":[\\\"nod-am\\\"],\\\"via\\\":[\\\"tag:exit\\\"]},{\\\"dst\\\":[\\\"autogroup:internet\\\"],\\\"ip\\\":[\\\"*\\\"],\\\"src\\\":[\\\"hermes-wb\\\"],\\\"via\\\":[\\\"tag:exit\\\"]},{\\\"app\\\":{\\\"tailscale.com/cap/relay\\\":[]},\\\"dst\\\":[\\\"agt\\\"],\\\"src\\\":[\\\"macos-ws\\\",\\\"hermes-wb\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"7890\\\"],\\\"src\\\":[\\\"hermes-wb\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"7890\\\"],\\\"src\\\":[\\\"dev\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"3001\\\",\\\"5900\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"macos-ws\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"agt\\\"]}],\\\"hosts\\\":{\\\"agt\\\":\\\"100.66.22.92\\\",\\\"dev\\\":\\\"100.101.189.7\\\",\\\"hermes-wb\\\":\\\"100.72.194.36\\\",\\\"macos-ws\\\":\\\"100.87.216.84\\\",\\\"nod-am\\\":\\\"100.123.207.1\\\"},\\\"tagOwners\\\":{\\\"tag:exit\\\":[\\\"xbpk3t@github\\\"],\\\"tag:svc\\\":[\\\"xbpk3t@github\\\"],\\\"tag:vps\\\":[\\\"xbpk3t@github\\\"],\\\"tag:ws\\\":[\\\"xbpk3t@github\\\"]},\\\"tests\\\":[]}\" : \"{\\\"autoApprovers\\\":{\\\"exitNode\\\":[\\\"tag:exit\\\"],\\\"services\\\":{\\\"svc:9router\\\":[\\\"tag:svc\\\"],\\\"svc:nezha\\\":[\\\"tag:svc\\\"]}},\\\"derpMap\\\":{\\\"OmitDefaultRegions\\\":false,\\\"Regions\\\":{\\\"900\\\":{\\\"Nodes\\\":[{\\\"DERPPort\\\":10043,\\\"HostName\\\":\\\"nva.lucc.dev\\\",\\\"IPv4\\\":\\\"1.15.64.188\\\",\\\"Name\\\":\\\"900a\\\",\\\"RegionID\\\":900,\\\"STUNPort\\\":10078}],\\\"RegionCode\\\":\\\"agt\\\",\\\"RegionID\\\":900,\\\"RegionName\\\":\\\"agt-sh\\\"}}},\\\"grants\\\":[{\\\"dst\\\":[\\\"tag:vps\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"dev\\\"],\\\"ip\\\":[\\\"8080\\\"],\\\"src\\\":[\\\"agt\\\"]},{\\\"dst\\\":[\\\"tag:ws\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"tag:vps\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"tag:svc\\\"],\\\"ip\\\":[\\\"8008\\\"],\\\"src\\\":[\\\"tag:vps\\\"]},{\\\"dst\\\":[\\\"tag:svc\\\"],\\\"ip\\\":[\\\"8008\\\"],\\\"src\\\":[\\\"macos-ws\\\"]},{\\\"dst\\\":[\\\"svc:9router\\\",\\\"svc:nezha\\\"],\\\"ip\\\":[\\\"80\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"autogroup:internet\\\"],\\\"ip\\\":[\\\"*\\\"],\\\"src\\\":[\\\"nod-am\\\"],\\\"via\\\":[\\\"tag:exit\\\"]},{\\\"dst\\\":[\\\"autogroup:internet\\\"],\\\"ip\\\":[\\\"*\\\"],\\\"src\\\":[\\\"hermes-wb\\\"],\\\"via\\\":[\\\"tag:exit\\\"]},{\\\"app\\\":{\\\"tailscale.com/cap/relay\\\":[]},\\\"dst\\\":[\\\"agt\\\"],\\\"src\\\":[\\\"macos-ws\\\",\\\"hermes-wb\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"7890\\\"],\\\"src\\\":[\\\"hermes-wb\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"7890\\\"],\\\"src\\\":[\\\"dev\\\"]},{\\\"dst\\\":[\\\"agt\\\"],\\\"ip\\\":[\\\"3001\\\",\\\"5900\\\"],\\\"src\\\":[\\\"tag:ws\\\"]},{\\\"dst\\\":[\\\"macos-ws\\\"],\\\"ip\\\":[\\\"22\\\"],\\\"src\\\":[\\\"agt\\\"]}],\\\"hosts\\\":{\\\"agt\\\":\\\"100.66.22.92\\\",\\\"dev\\\":\\\"100.101.189.7\\\",\\\"hermes-wb\\\":\\\"100.72.194.36\\\",\\\"macos-ws\\\":\\\"100.87.216.84\\\",\\\"nod-am\\\":\\\"100.123.207.1\\\"},\\\"tagOwners\\\":{\\\"tag:exit\\\":[\\\"xbpk3t@github\\\"],\\\"tag:svc\\\":[\\\"xbpk3t@github\\\"],\\\"tag:vps\\\":[\\\"xbpk3t@github\\\"],\\\"tag:ws\\\":[\\\"xbpk3t@github\\\"]},\\\"tests\\\":[{\\\"accept\\\":[\\\"tag:vps:22\\\",\\\"tag:ws:22\\\",\\\"agt:8080\\\",\\\"svc:9router:80\\\",\\\"svc:nezha:80\\\"],\\\"deny\\\":[\\\"tag:vps:80\\\",\\\"198.51.100.8:22\\\"],\\\"src\\\":\\\"tag:ws\\\"},{\\\"accept\\\":[\\\"dev:8080\\\"],\\\"src\\\":\\\"agt\\\"},{\\\"accept\\\":[\\\"tag:vps:22\\\",\\\"tag:svc:8008\\\",\\\"agt:8080\\\"],\\\"deny\\\":[\\\"tag:ws:22\\\"],\\\"src\\\":\\\"tag:vps\\\"},{\\\"accept\\\":[\\\"tag:svc:8008\\\"],\\\"src\\\":\\\"macos-ws\\\"},{\\\"accept\\\":[\\\"svc:9router:80\\\",\\\"svc:nezha:80\\\"],\\\"deny\\\":[\\\"tag:svc:8008\\\"],\\\"src\\\":\\\"nod-am\\\"},{\\\"accept\\\":[\\\"agt:7890\\\"],\\\"src\\\":\\\"hermes-wb\\\"},{\\\"accept\\\":[\\\"agt:3001\\\",\\\"agt:5900\\\"],\\\"src\\\":\\\"tag:ws\\\"}]}\"}"
      }
    },
    "tailscale_device_key": {
      "servers": {
        "device_id": "${each.value.id}",
        "for_each": "${data.tailscale_device.servers}",
        "key_expiry_disabled": true
      }
    },
    "tailscale_device_tags": {
      "hermes_wb": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "device_id": "${data.tailscale_device.servers[\"hermes-wb\"].id}",
        "tags": [
          "tag:vps"
        ]
      },
      "macos_ws": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "device_id": "${data.tailscale_device.servers[\"macos-ws\"].id}",
        "tags": [
          "tag:ws"
        ]
      },
      "nixos_vps_agt": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "device_id": "${data.tailscale_device.servers[\"nixos-vps-agt\"].id}",
        "tags": [
          "tag:vps"
        ]
      },
      "nixos_vps_dev": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "device_id": "${data.tailscale_device.servers[\"nixos-vps-dev\"].id}",
        "tags": [
          "tag:exit",
          "tag:svc",
          "tag:vps"
        ]
      },
      "nixos_wsl": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "device_id": "${data.tailscale_device.servers[\"nixos-wsl\"].id}",
        "tags": [
          "tag:ws"
        ]
      }
    },
    "tailscale_dns_preferences": {
      "main": {
        "magic_dns": true
      }
    },
    "tailscale_service": {
      "nezha": {
        "comment": "Nezha dashboard (HTTP over tailnet)",
        "name": "svc:nezha",
        "ports": [
          "tcp:80"
        ]
      },
      "ninerouter": {
        "comment": "9router dashboard (HTTP over tailnet)",
        "name": "svc:9router",
        "ports": [
          "tcp:80"
        ]
      }
    },
    "tailscale_tailnet_key": {
      "vps_join": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "ephemeral": false,
        "expiry": 7776000,
        "preauthorized": false,
        "reusable": true,
        "tags": [
          "tag:vps"
        ]
      },
      "ws_join": {
        "depends_on": [
          "tailscale_acl.main"
        ],
        "ephemeral": false,
        "expiry": 7776000,
        "preauthorized": false,
        "reusable": true,
        "tags": [
          "tag:ws"
        ]
      }
    }
  },
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "luck-dotfiles-opentofu-state",
        "endpoints": {
          "s3": "https://96540bd100b82adba941163704660c31.r2.cloudflarestorage.com"
        },
        "key": "homelab/tailscale/tailnet/terraform.tfstate",
        "region": "auto",
        "skip_credentials_validation": true,
        "skip_metadata_api_check": true,
        "skip_region_validation": true,
        "skip_requesting_account_id": true,
        "skip_s3_checksum": true,
        "use_lockfile": true,
        "use_path_style": true
      }
    },
    "required_providers": {
      "tailscale": {
        "source": "tailscale/tailscale",
        "version": "~> 0.18"
      }
    },
    "required_version": ">= 1.10.0"
  },
  "variable": {
    "tailscale_acl_allow_all": {
      "default": false,
      "description": "Keep the legacy *→* grant while devices are tagged and re-authenticated. Default false = least-privilege ACL.",
      "type": "bool"
    }
  }
}
