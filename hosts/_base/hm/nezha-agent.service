[Unit]
Description=Nezha Agent (hm workbench)
After=network-online.target user@0.service
Wants=network-online.target

[Service]
Type=simple
# The HM sops template renders /root/.config/nezha/config.json after the
# user manager + sops-nix user service are up. Wait for it before starting.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 120); do [ -s /root/.config/nezha/config.json ] && exit 0; sleep 2; done; exit 1'
ExecStart=/root/.nix-profile/bin/nezha-agent --config /root/.config/nezha/config.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
